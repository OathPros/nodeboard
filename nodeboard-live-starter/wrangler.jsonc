{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nodeboard-live",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "durable_objects": {
    "bindings": [{"name": "BOARD_SESSIONS", "class_name": "BoardSession"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["BoardSession"]}],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {"enabled": true}
}
