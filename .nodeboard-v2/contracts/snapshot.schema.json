{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeboard:draft:snapshot:2",
  "title": "Nodeboard v2 snapshot, proposed structural contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "ontology", "graph", "views", "presentation", "metadata"],
  "properties": {
    "format": { "const": "nodeboard" },
    "version": { "const": 2 },
    "ontology": { "$ref": "#/$defs/ontology" },
    "graph": { "$ref": "#/$defs/graph" },
    "views": { "type": "array", "items": { "$ref": "#/$defs/view" } },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classStyles", "relationshipStyles"],
      "properties": {
        "classStyles": { "$ref": "#/$defs/object" },
        "relationshipStyles": { "$ref": "#/$defs/object" }
      }
    },
    "metadata": { "$ref": "#/$defs/object" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "value": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "$ref": "#/$defs/object" }
      ]
    },
    "object": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "actorId": { "$ref": "#/$defs/id" },
        "assertedAt": { "type": "string", "format": "date-time" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "metadata": { "$ref": "#/$defs/object" }
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "superclassIds", "abstract", "propertyDefinitionIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "definition": { "type": "string" },
        "superclassIds": { "$ref": "#/$defs/ids" },
        "abstract": { "type": "boolean" },
        "propertyDefinitionIds": { "$ref": "#/$defs/ids" },
        "metadata": { "$ref": "#/$defs/object" }
      }
    },
    "relationshipType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "predicate", "label", "domainClassIds", "rangeClassIds", "inversePredicateId", "symmetric", "transitive"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "predicate": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "definition": { "type": "string" },
        "domainClassIds": { "$ref": "#/$defs/ids" },
        "rangeClassIds": { "$ref": "#/$defs/ids" },
        "inversePredicateId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "symmetric": { "type": "boolean" },
        "transitive": { "type": "boolean" },
        "metadata": { "$ref": "#/$defs/object" }
      }
    },
    "propertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "dataType"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "definition": { "type": "string" },
        "dataType": { "enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "uri", "enum", "list", "structured"] },
        "enumValues": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "listItemType": { "enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "uri", "enum", "structured"] },
        "metadata": { "$ref": "#/$defs/object" }
      },
      "allOf": [
        { "if": { "properties": { "dataType": { "const": "enum" } }, "required": ["dataType"] }, "then": { "required": ["enumValues"] } },
        { "if": { "properties": { "dataType": { "const": "list" } }, "required": ["dataType"] }, "then": { "required": ["listItemType"] } },
        { "if": { "properties": { "dataType": { "const": "list" }, "listItemType": { "const": "enum" } }, "required": ["dataType", "listItemType"] }, "then": { "required": ["enumValues"] } }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["required", "cardinality", "uniqueness", "allowedTarget", "pattern", "disjointness", "conditional", "acyclic"] },
        "parameters": { "$ref": "#/$defs/object" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "required" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classId", "propertyId"],
                "properties": {
                  "classId": { "$ref": "#/$defs/id" },
                  "propertyId": { "$ref": "#/$defs/id" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "cardinality" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classId", "relationshipTypeId", "direction"],
                "properties": {
                  "classId": { "$ref": "#/$defs/id" },
                  "relationshipTypeId": { "$ref": "#/$defs/id" },
                  "direction": { "enum": ["in", "out"] },
                  "minimum": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "maximum": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "anyOf": [{ "required": ["minimum"] }, { "required": ["maximum"] }]
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "uniqueness" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classId", "propertyId"],
                "properties": {
                  "classId": { "$ref": "#/$defs/id" },
                  "propertyId": { "$ref": "#/$defs/id" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "disjointness" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classIds"],
                "properties": {
                  "classIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "acyclic" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["relationshipTypeId"],
                "properties": {
                  "relationshipTypeId": { "$ref": "#/$defs/id" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "allowedTarget" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classId", "relationshipTypeId", "targetClassIds"],
                "properties": {
                  "classId": { "$ref": "#/$defs/id" },
                  "relationshipTypeId": { "$ref": "#/$defs/id" },
                  "targetClassIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "conditional" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classId", "when", "requirePropertyIds"],
                "properties": {
                  "classId": { "$ref": "#/$defs/id" },
                  "when": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["propertyId", "equals"],
                    "properties": {
                      "propertyId": { "$ref": "#/$defs/id" },
                      "equals": { "$ref": "#/$defs/value" }
                    }
                  },
                  "requirePropertyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "pattern" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classId", "propertyId", "syntax", "pattern"],
                "properties": {
                  "classId": { "$ref": "#/$defs/id" },
                  "propertyId": { "$ref": "#/$defs/id" },
                  "syntax": { "const": "glob" },
                  "pattern": { "type": "string", "maxLength": 256 }
                }
              }
            }
          }
        }
      ]
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "classes", "relationshipTypes", "propertyDefinitions", "constraints"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "classes": { "type": "array", "items": { "$ref": "#/$defs/class" } },
        "relationshipTypes": { "type": "array", "items": { "$ref": "#/$defs/relationshipType" } },
        "propertyDefinitions": { "type": "array", "items": { "$ref": "#/$defs/propertyDefinition" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classIds", "name", "properties", "externalIds", "provenance", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "classIds": { "$ref": "#/$defs/ids" },
        "name": { "type": "string" },
        "properties": { "$ref": "#/$defs/object" },
        "externalIds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "value"],
            "properties": { "namespace": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 } }
          }
        },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } },
        "status": { "enum": ["active", "draft", "retired"] },
        "metadata": { "$ref": "#/$defs/object" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relationshipTypeId", "properties", "provenance", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "relationshipTypeId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "reason"],
          "properties": {
            "label": { "type": "string" },
            "reason": { "type": "string", "minLength": 1 },
            "metadata": { "$ref": "#/$defs/object" }
          }
        },
        "properties": { "$ref": "#/$defs/object" },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } },
        "status": { "enum": ["asserted", "proposed", "disputed", "superseded"] },
        "metadata": { "$ref": "#/$defs/object" }
      },
      "allOf": [
        {
          "if": { "properties": { "relationshipTypeId": { "type": "null" } }, "required": ["relationshipTypeId"] },
          "then": { "required": ["legacy"] }
        }
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "relationships"],
      "properties": {
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "scope", "query", "entityIds", "positions", "viewport"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["personal", "shared"] },
        "ownerId": { "$ref": "#/$defs/id" },
        "query": { "$ref": "#/$defs/object" },
        "entityIds": { "$ref": "#/$defs/ids" },
        "positions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/position" } },
        "viewport": {
          "type": "object", "additionalProperties": false, "required": ["x", "y", "zoom"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "zoom": { "type": "number", "exclusiveMinimum": 0 } }
        }
      },
      "allOf": [
        { "if": { "properties": { "scope": { "const": "personal" } }, "required": ["scope"] }, "then": { "required": ["ownerId"] } }
      ]
    }
  }
}
